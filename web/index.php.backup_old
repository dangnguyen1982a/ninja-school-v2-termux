$ADMIN_PASS = 'admin123';

/* ================= LOGIN ================= */
if (isset($_GET['logout'])) {
    session_destroy();
    header('Location: ./');
    exit;
}

if (!isset($_SESSION['admin'])) {
    if ($_SERVER['REQUEST_METHOD'] === 'POST') {
        if (
            ($_POST['username'] ?? '') === $ADMIN_USER &&
            ($_POST['password'] ?? '') === $ADMIN_PASS
        ) {
            $_SESSION['admin'] = true;
            header('Location: ./');
            exit;
        }
        $error = 'Sai tài khoản hoặc mật khẩu!';
    }

    ?>
