                            <?php else: ?>
                                <input type="text" name="<?=h($name)?>" class="form-control form-control-gaming" value="<?=h($value)?>">
                            <?php endif; ?>
                        </div>
                        <?php endforeach; ?>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="?db=<?=h($dbname)?>&table=<?=h($table)?>" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-glow-warning">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    // Tự động mở modal sửa khi trang load
    document.addEventListener('DOMContentLoaded', function() {
        var editModal = new bootstrap.Modal(document.getElementById('editModal'));
        editModal.show();
    });
</script>
<?php endif; ?>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
<?php
// Nếu có edit nhưng không tìm thấy dữ liệu, chuyển về trang table
if ($table && isset($_GET['edit']) && !$editData) {
    header("Location: ?db=".urlencode($dbname)."&table=".urlencode($table));
    exit;
}
?>
